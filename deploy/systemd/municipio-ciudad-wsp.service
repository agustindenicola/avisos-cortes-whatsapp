[Unit]
Description=Municipio Ciudad - conector WhatsApp
After=network-online.target municipio-ciudad.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/agustin/municipio-ciudad
EnvironmentFile=/home/agustin/municipio-ciudad/.env
ExecStart=/usr/bin/npm run connector:wsp
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
