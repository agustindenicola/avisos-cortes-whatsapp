[Unit]
Description=Municipio Ciudad - panel operativo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/agustin/municipio-ciudad
EnvironmentFile=/home/agustin/municipio-ciudad/.env
ExecStart=/usr/bin/python3 /home/agustin/municipio-ciudad/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
